projection;
strict ( 2 );
use draft;

define behavior for ZCC_EMH_22IT115 alias EnergyMeterHdr
{
  use create;
  use update;
  use delete;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;
  use action Resume;
  use association _EnergyReading { create; with draft; }
}

define behavior for ZCC_EMI_22IT115 alias EnergyMeterItm
{
  use update;
  use delete;
  use association _EnergyHeader { with draft; }
}